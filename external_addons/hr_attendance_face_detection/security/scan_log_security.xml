<odoo>
    <record id="scan_log_company_rule" model="ir.rule">
        <field name="name">Face scan logs: allowed companies</field>
        <field name="model_id" ref="model_hr_attendance_face_scan_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="scan_log_officer_rule" model="ir.rule">
        <field name="name">Face scan logs: own or managed employees</field>
        <field name="model_id" ref="model_hr_attendance_face_scan_log"/>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('employee_id.attendance_manager_id', '=', user.id)]</field>
    </record>
    <record id="scan_log_manager_rule" model="ir.rule">
        <field name="name">Face scan logs: attendance administrators</field>
        <field name="model_id" ref="model_hr_attendance_face_scan_log"/>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
