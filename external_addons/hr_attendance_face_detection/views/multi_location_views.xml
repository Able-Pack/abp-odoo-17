<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="multi_location_hr_attendance_face_detection_list" model="ir.ui.view">
        <field name="name">multi.location.hr.attendance.face.detection.list</field>
        <field name="model">multi.location</field>
        <field name="arch" type="xml">
            <tree string="Multi Location" editable="bottom">
                <field name="name"/>
                <field name="google_maps_link" placeholder="https://maps.app.goo.gl/..."/><field name="face_attendance_latitude" string="Latitude"/>
                <field name="face_attendance_longitude" string="Longitude"/>
                <field name="face_attendance_radius" string="Radius (meters)"/><field name="map_picker" widget="attendance_location_picker"/>
            </tree>
        </field>
    </record>

    <record id="multi_location_hr_attendance_face_detection" model="ir.ui.view">
        <field name="name">multi.location.hr.attendance.face.detection.form</field>
        <field name="model">multi.location</field>
        <field name="arch" type="xml">
            <form string="Multi Location">
                <sheet string="Multi Location">
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="google_maps_link" placeholder="https://maps.app.goo.gl/..."/><field name="face_attendance_latitude" string="Latitude"/>
                        <field name="face_attendance_longitude" string="Longitude"/>
                        <field name="face_attendance_radius" string="Radius (meters)"/><field name="map_picker" widget="attendance_location_picker"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>

